# ==========================================
# MULTI-PROVIDER LLM ADAPTER CONFIGURATION
# ==========================================

# Lựa chọn LLM Provider: "gemini", "openai", "shopapi", hoặc "mock" (offline)
LLM_PROVIDER=gemini

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_MODEL=claude-3-5-haiku-20241022

# ShopAIKey (OpenAI-compatible endpoint)
# LLM_PROVIDER=shopapi
SHOPAPI_BASE_URL=https://api.shopaikey.com/v1
SHOPAPI_MODEL=gemini-2.5-flash
SHOPAPI_API_KEY=replace_with_your_key

# MCP Configuration
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8000
